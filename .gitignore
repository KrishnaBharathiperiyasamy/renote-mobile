# ==============================================================================
# ReNote Monorepo Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Frontend Builds
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
bin/
*/bin/
.turbo/
.cache/

# Environment Variables & Secrets (Prevent accidental credential leaks)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
*.env
!.env.example
!*/.env.example

# Media Uploads & Temporary Storage
uploads/
*/uploads/
tmp/
*/tmp/
temp/
*/temp/
tmp_zip/
*/tmp_zip/
temp.txt
*/temp.txt
public/uploads/
*/public/uploads/
public/downloads/
*/public/downloads/
public/rendered/
*/public/rendered/
public/temp/
*/public/temp/

# Logs & Debug Output
*.log
*/server.log
*/frontend.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript & Linter Caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# Security & Keys
*.pem
*.key
*.cert
*.crt
id_rsa*

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Test & Scratch scripts
test_sa.mjs
scratch/
.gemini/
